# Тип кімнати
#-------------------
# кожен тип кімнати розділяється символом ;
room_type:chysta;dlia_hotuvannia;dlia_vidpochynku;dlia_roboty;dlia_zberihannia

# Гравець
# Ці значення зазвичай порожні
(P):#(P)_adj# | #(P)_noun#
(P)_noun:Nikhto
(P)_adj:Nemaie

# Кімнати:
# Кожен roomType повинен мати відповідні кімнати
#-------------------
# Створення кімнати: спочатку беремо назву roomtype, вказану в #room_type#,
# яку умовно назвемо X. Створюємо три символи:
# X_(r), X_(r)_noun та X_(r)_adj.
# X_(r) завжди складається з X_(r)_adj | X_(r)_noun.
# Якщо потрібно поділити тип кімнати на два або більше варіантів,
# можна додати _type1, _type2 тощо до символів noun та adj.
# Необхідно також врахувати ці зміни в токені X_(r).

(r):#(r)_adj# | #(r)_noun#
(r)_noun:vbyralnia;vanna kimnata;shafa;komora;pidval;harderobna;kukhnia;mini-kukhnia
(r)_adj:neprymitnyi;prostyi

clean_(r):#clean_(r)_adj_type_1# | #clean_(r)_noun_type_1#;#clean_(r)_adj_type_2# | #clean_(r)_noun_type_2#;#clean_(r)_adj_type_3# | #clean_(r)_noun_type_3# ; #clean_(r)_adj_type_4# | #clean_(r)_noun_type_4#

# Прибирання
clean_(r)_noun_type_1:vbyralnia;vanna kimnata;tualet
clean_(r)_adj_type_1:bezdohannyi;chystyi;tisnyi

# Прання
