# Фрагменти Inform7
#-----------------
# Не повинні потребувати змін. Це скорочення для випадків, коли потрібно використовувати код i7.
# Ймовірно, не варто включати символи або токени всередину цих фрагментів.
i7_closed/open:[if (obj) is open]an open[otherwise]a closed[end if]
i7_list_in:[a list of things in the (obj)]
i7_list_on:[a list of things on the (obj)]
i7_empty:[if (obj) contains nothing]an empty[otherwise]a[end if]
inform7:[if (obj) is locked]a locked[else if (obj) is open]an open[otherwise]a closed[end if]
inform7A:[if (obj) is locked]A locked[else if (obj) is open]An open[otherwise]A closed[end if]
inform7noa:[if (obj) is locked]a locked[else if (obj) is open]an open[otherwise]a closed[end if]
inform7noun:[if (obj) is locked]locked[else if (obj) is open]open[otherwise]closed[end if]
inform7nounnoa:[if (obj) is locked]locked[else if (obj) is open]open[otherwise]closed[end if]

# Вступ до кімнати
#----------

# Текст для представлення кімнати. Наприклад:
# «Вітаю, тепер ти перебуваєш у затишній кухні»
dec:#dec_type##suffix_(r)#

### Перше відвідування кімнати ###
dec_type:#reg-0#;#normal-0#;#difficult-0#;#moredifficult-0#;#playful-0#
reg-0:#04#;#05#;#06#
normal-0:#07#
difficult-0:#016#
moredifficult-0:#017#
playful-0:#01#;#02#;#03#;#08#;#09#;#010#;#011#;#012#;#013#;#014#;#015#;#018#;#019#;#020#;#021#;#022#;#023#;#024#;#025#;#026#;#027#;#028#

### Повторне відвідування кімнати ###
revisit:Ty znovu uviishov do (name).;Ty znovu zakhodysh do (name). Ty nastilky rozghubyvsia, shcho tobi potribno nahadaty, shcho tut ye, khocha ty buv tut lyshe kilka sekund tomu.;Shcho, ty dumav, shcho yakshcho pidesh kudys i poverneshsia, tse mistse perestane buty (name)?;A, (name). Tut u tebe stilky chudovykh spohadiv. Svizhykh spohadiv. Ty buv tut bukvalno sekundu tomu.;Nu os ty y povernuvsia do (name).;Tilky-no ty podumav, shcho bilshe nikoly ne pobachysh (name), yak znovu opynyvsia v nomu.;Z povernenniam do (name).

