# Описи виходів
#--------------

# room_desc_(d): описує одні двері в кімнаті
# room_desc_(dir): описує один незаблокований вихід у кімнаті
# room_exit_desc: описує кілька незаблокованих виходів у кімнаті
# room_desc_exits: можливо, непотрібне
# room_desc_doors_closed: описує групу закритих дверей у кімнаті
# room_desc_doors_open: описує групу відкритих дверей у кімнаті

room_desc_(d):Є #i7_closed/open# (name), що ведуть (dir).

room_desc_(dir):Є #unblocked# вихід до (dir).;Є вихід до (dir). Не хвилюйтеся, він #unblocked#.;Потрібен #unblocked# вихід? Спробуйте піти (dir).;Ви не любите двері? Тоді чому б не піти (dir), цей вхід #unblocked#.

room_exit_desc:#easy1#.;#medium1#.;#hard1#.

room_desc_exits:Там [є|є] #unblocked# [вихід|виходи] до (dir).

room_desc_doors_closed:#easy0a#.
