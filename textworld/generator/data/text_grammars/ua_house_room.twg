# Описи опор
#----------------------

# Подібні до описів контейнерів, але без відкриття/закриття та блокування/розблокування
# room_desc_(s): головний вузол
# room_desc_(s)_1_noun : опис опори без прикметника. Поєднується з room_desc_(s)_2_adj
# room_desc_(s)_1_name : те саме, але з прикметником
# room_desc_(s)_2_adj : прикметник для опори плюс список предметів на ній
# room_desc_(s)_2:

room_desc_(s):#room_desc_(s)_1_noun# #room_desc_(s)_2_adj#;#room_desc_(s)_1_name# #room_desc_(s)_2#

room_desc_(s)_1_noun:#prefix# (name-n)#suffix_(s)_mid#

room_desc_(s)_1_name:#prefix# (name)#suffix_(s)_mid#

room_desc_(s)_2_adj:(name-n) є (name-adj).[if there is something on the (obj)] На (name) #how_see_u# #i7_list_on##suffix_(s)_end#[end if][if there is nothing on the (obj)] #emptysupporter##suffix_(s)_end_angry#[end if]

#;(name-n) є (name-adj) [if name has something on it] на (name) #i7_list_on#[else if the (name) is empty]#emptysupporter#[end if]

room_desc_(s)_2:[if there is something on the (obj)]На (name) #how_see_u# #i7_list_on##suffix_(s)_end#[end if][if there is nothing on the (obj)]#emptysupporter##suffix_(s)_end_angry#[end if];[if there is something on the (obj)]Ти бачиш #i7_list_on# на (name-n)#suffix_(s)_end#[end if][if there is nothing on the (obj)]#emptysupporter##suffix_(s)_end_angry#[end if]

#[if name has something on it] на (name) #i7_list_on#[else if the (name) is empty]#emptysupporter#[end if]

room_desc_(s)_multi_noun:[if there is something on the (obj)]На (name-n) ти бачиш #i7_list_on##suffix_(s)_end#[end if][if there is nothing on the (obj)]#emptysupporter_multi##suffix_(s)_end_angry#[end if]

room_desc_(s)_multi_adj:[if there is something on the (obj)]На (name-adj) варіанті ти бачиш #i7_list_on##suffix_(s)_end#[end if][if there is nothing on the (obj)]#emptysupporter_multi##suffix_(s)_end_angry#[end if]

emptysupporter:Але на ньому нічого немає;На жаль, на ньому нічого немає;Але ця річ порожня;Але ця річ, на жаль, порожня;Але на цій речі нічого немає;О ні! На цьому шматку #trash# нічого немає;Схоже, (name-n) порожній;Схоже, тут уже хтось побував і все з нього забрав;Проте (name-n), як і порожній (name-n), не має на собі нічого;
emptysupporter_multi:На (name-n) нічого немає;(name-n) порожній;Поглянь на (name-n). На цьому шматку #trash# нічого немає;Але на (name-n) нічого немає;Яке розчарування, тут нічого немає;

