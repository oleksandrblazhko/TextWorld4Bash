#-------------------------
# Граматика опису кімнати
#-------------------------

# Фрагменти Inform7
#-------------------
# Не повинно виникати потреби змінювати це. Це скорочення для випадків,
# коли потрібно використати код i7. Ймовірно, погана ідея включати сюди
# символи або токени.
i7_closed/open:[if (obj) is open]відкритий[otherwise]закритий[end if]
i7_list_in:[список предметів у (obj)]
i7_list_on:[список предметів на (obj)]
i7_empty:[if (obj) contains nothing]порожній[otherwise]непорожній[end if]
inform7:[if (obj) is locked]замкнений[else if (obj) is open]відкритий[otherwise]закритий[end if]
inform7A:[if (obj) is locked]Замкнений[else if (obj) is open]Відкритий[otherwise]Закритий[end if]
inform7noa:[if (obj) is locked]замкнений[else if (obj) is open]відкритий[otherwise]закритий[end if]
inform7noun:[if (obj) is locked]замкнений[else if (obj) is open]відкритий[otherwise]закритий[end if]
inform7nounnoa:[if (obj) is locked]замкнений[else if (obj) is open]відкритий[otherwise]закритий[end if]

# Вступ до кімнати
#----------------
# Текст для представлення кімнати. Наприклад:
# "Вітаємо, ви зараз у гарячій кухні"
# dec:[if unvisited]#GREETING!# #dec_type##suffix_(r)#[otherwise]#revisit#[end if];
# [if unvisited]#dec_type##suffix_(r)#[otherwise]#revisit#[end if]
dec:#dec_type##suffix_(r)#

### Перший раз у кімнаті ###

dec_type:#reg-0#;#normal-0#;#difficult-0#;#moredifficult-0#;#playful-0#
reg-0:#04#;#05#;#06#
normal-0:#07#
difficult-0:#016#
moredifficult-0:#017#
playful-0:#01#;#02#;#03#;#08#;#09#;#010#;#011#;#012#;#013#;#014#;#015#;#018#;#019#;#020#;#021#;#022#;#023#;#024#;#025#;#026#;#027#;#028#

### Повторний вхід до кімнати ###

revisit:Ви знову увійшли до (name).;Ви знову входите до (name). Ви такі розгублені, що вам потрібно нагадати, що є в кімнаті, хоча ви були тут лише кілька секунд тому.;Що, ви думали, що якщо підете кудись і повернетеся, це місце перестане бути (name)?;А, (name). У вас багато чудових спогадів про це місце. Свіжих спогадів. Ви були тут лише секунду тому.;Ну ось ви й повернулися до (name).;Щойно ви подумали, що більше ніколи не побачите (name), як знову повертаєтеся сюди.;Ласкаво просимо назад до (name).

# Шаблони вступу до кімнати
#--------------------------

01:Мені шкода повідомляти, але тепер ви перебуваєте в (name)
02:А, (name-n). Це якийсь (name-n), справді чудова атмосфера (name-adj) у цьому місці, чудова (name-adj) атмосфера. І тепер, ну, ви в ньому
03:Гаразд, отже, ви в (name-n), круто, але чи він (name-adj)? Ще б пак
04:#dec_find-yourself# у (name);#dec_guess-what# (name)
05:Ну ось ми й опинилися в #dec_a_the# (name)
06:Тепер ви в #dec_a_the# (name)
07:Ви увійшли до (name);Ви щойно #dec_walked_into# (name)
08:Це може стати для вас шоком, але ви щойно #dec_entered# (name)
09:Я #announce_mood# повідомити, що тепер ви перебуваєте в (name)
010:А, (name-n). Це якийсь (name-n), справді чудова атмосфера (name-adj) у цьому місці, чудова (name-adj) атмосфера
011:Ви #dec_entered# до най(name-adj)нішого з усіх можливих (name-n)
012:З усіх (name-n), до яких ви могли #dec_walked_into#, вам довелося #dec_walk_into# саме до (name-adj)
013:Ви #dec_entered# до (name-n). Не до того (name-n), якого ви очікували. Ні, це (name)
014:Ви перебуваєте в (name-n). Схоже, тут досить (name-adj)
015:Ви #dec_what# у місці, яке можна назвати (name-adj). Тобто ви перебуваєте в (name-n)
016:#dec_find-yourself# у (name-n). Досить (name-adj)
017:#dec_find-yourself# у (name-n). Таке собі (name-adj) місце
018:#017#
019:Ви #dec_entered# до (name-adj) кімнати. Ваш розум гарячково намагається придумати, яка кімната могла б бути (name-adj). І тут вас осяює. Звичайно. Ви в (name)
020:Якщо вам цікаво, чому раптом усе здається таким (name-adj), це тому, що ви щойно #dec_walked_into# до (name)
021:Яка несподівана зустріч. Тут, до речі, — це (name);Я ніколи не вважав вас людиною, яка з'явиться в (name), але, схоже, я помилявся
022:Це звучатиме неймовірно, але ви щойно увійшли до (name);Ви не повірите, але ви щойно увійшли до (name)
023:Ви робите грандіозний ексцентричний вхід до (name);Ви робите ще один зі своїх грандіозних ексцентричних входів до (name)
024:Подивіться на себе, великий бос, який заходить у (name), ніби це не якась величезна подія
025:Озирніться навколо. Оцініть усе це. Не щодня комусь випадає побувати в (name)
026:Ви бачили й кращі (name-n), але принаймні цей здається досить (name-adj);Я просто вважаю чудовим, що ви зараз у (name);Я просто вважаю чудовим, що ви щойно увійшли до (name)
027:#signquality# #sign# повідомляє вам, що тепер ви перебуваєте в (name);Погляньте на цей #sign#! Що там написано? Там написано «Ласкаво просимо до (name)»? Ну, це круто
028:Щойно надійшла новина — ви, у (name);Ласкаво просимо до (name);Ого! Ви в (name);Ну ось ми й у (name);Ви увійшли до (name);Цей (name-n), до якого ви щойно увійшли, безумовно є (name-adj)

# Розширювані елементи для символів кімнати
#------------------------------------------

GREETING!:ВІТАЄМО!;ВІТАЮ!;ПРИВІТ!;ОТЖЕ, ПОЧНЕМО!
dec_entered:увійшли;зайшли;впали;перемістилися;ввалилися;потрапили
dec_find-yourself:Ви #dec_what#
dec_guess-what:#dec_well-guess#, ви перебуваєте в #dec_a_the# місці, яке ми називаємо #dec_a_the#
dec_well-guess:Вгадайте що;Ну ось як;Ну, хто б міг подумати
dec_what:є;опиняєтесь;прибуваєте
dec_a_the:а;це
dec_in_at:у;в
dec_walk_into:увійти;зайти;пройти;прогулятися до
dec_walked_into:увійшли;зайшли;пройшли
announce_mood:шкода;радий;схвильований;у захваті;дуже щасливий;маю честь;змушений;зобов'язаний
signquality:занедбаний;іржавий;ламінований;кривий;добре обрамлений
sign:знак;плакат;оголошення;табличка;дошка

# Розділювачі описів
#------------------
# Використовуються для розділення описів різних типів об'єктів

#First
#first:Спочатку ви шукаєте (next object type);Спочатку ви оглядаєте кімнату в пошуках (next object type);Спочатку ви оглядаєте кімнату, шукаючи (next object type)
#Middle
#middle:Після цього ви шукаєте (next object type);Після того як ви визначили кількість (previous object type), ви починаєте шукати (next object type);
#Last
#last:і нарешті ви перевіряєте (next object type)

# Опис контейнерів
#----------------
# Правила опису контейнерів
# room_desc_(c): генерує всі описи контейнерів
# containerdescription: містить усі описи зовнішнього вигляду контейнерів
# room_desc_(c)_1_name: описує контейнер як прикметник+іменник
# room_dec_(c)_1_noun: описує контейнер як іменник
# room_desc_(c)_content: визначає, чи потрібно додати опис вмісту контейнера залежно від того, чи він відкритий
# opencontainer: те, що додається, якщо контейнер відкритий
# room_desc_(c)_2_adj: додає прикметник і список вмісту
# room_desc_(c)_2: список вмісту без прикметника

room_desc_(c):#containerdescription##room_desc_(c)_content#
#special_container#.

containerdescription:#room_desc_(c)_1_name#;#room_desc_(c)_1_noun#

room_desc_(c)_content:[if (obj) is open and there is something in the (obj)] #opencontainer##suffix#[end if][if (obj) is open and the (obj) contains nothing] #emptyreaction#[end if]

opencontainer:(name) містить #i7_list_in#

#room_desc_(c)_2_adj#;#room_desc_(c)_2#

emptyreaction:(name-n) порожній, який жахливий день!;(name-n) порожній! Яка втрата дня!;(name-n) порожній! Це найгірше, що взагалі могло статися!;Порожньо! Який же це кошмарний TextWorld?;Яке розчарування! (name-n) порожній!

room_desc_(c)_1_name:#reg-a#;#normal-a#;#difficult-a#;#moredifficult-a#;#playful-a#

reg-a:#a1#;#a2#
normal-a:#a3#;#a4#;#a5#
difficult-a:#a6#
moredifficult-a:#reg-a#
playful-a:#reg-a#

room_desc_(c)_1_noun:#reg-b#;#normal-b#;#difficult-b#;#moredifficult-b#;#playful-b#

reg-b:#b1#;#b2#
normal-b:#b3#;#b4#;#b5#
difficult-b:#reg-b#
moredifficult-b:#reg-b#
playful-b:#reg-b#

