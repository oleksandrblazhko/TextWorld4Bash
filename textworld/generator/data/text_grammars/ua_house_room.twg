# Опис опорних поверхонь (Supporter)
#------------------------------------
# Подібно до описів контейнерів, але без відкриття/закриття або замикання/відмикання
# room_desc_(s): головний елемент
# room_desc_(s)_1_noun: опис опори без прикметника. Поєднується з --> room_desc_(s)_2_adj
# room_desc_(s)_1_name: те саме, що вище, але з прикметником
# room_desc_(s)_2_adj: прикметник для опори плюс список предметів на ній
# room_desc_(s)_2:

room_desc_(s):#room_desc_(s)_1_noun# #room_desc_(s)_2_adj#;#room_desc_(s)_1_name# #room_desc_(s)_2#

room_desc_(s)_1_noun:#prefix# (name-n)#suffix_(s)_mid#

room_desc_(s)_1_name:#prefix# (name)#suffix_(s)_mid#

room_desc_(s)_2_adj:(name-n) є (name-adj).[if there is something on the (obj)] На (name) #how_see_u# #i7_list_on##suffix_(s)_end#[end if][if there is nothing on the (obj)] #emptysupporter##suffix_(s)_end_angry#[end if]

#;(name-n) є (name-adj) [if name has something on it] на (name) #i7_list_on#[else if the (name) is empty]#emptysupporter#[end if]

room_desc_(s)_2:[if there is something on the (obj)]На (name) #how_see_u# #i7_list_on##suffix_(s)_end#[end if][if there is nothing on the (obj)]#emptysupporter##suffix_(s)_end_angry#[end if];[if there is something on the (obj)]Ви бачите #i7_list_on# на (name-n)#suffix_(s)_end#[end if][if there is nothing on the (obj)]#emptysupporter##suffix_(s)_end_angry#[end if]

#[if name has something on it] на (name) #i7_list_on#[else if the (name) is empty]#emptysupporter#[end if]

room_desc_(s)_multi_noun:[if there is something on the (obj)]На (name-n) ви бачите #i7_list_on##suffix_(s)_end#[end if][if there is nothing on the (obj)]#emptysupporter_multi##suffix_(s)_end_angry#[end if]

room_desc_(s)_multi_adj:[if there is something on the (obj)]На (name-adj) ви бачите #i7_list_on##suffix_(s)_end#[end if][if there is nothing on the (obj)]#emptysupporter_multi##suffix_(s)_end_angry#[end if]

emptysupporter:Але на ньому нічого немає;На жаль, на ньому нічого немає;Але він порожній;Але він, на жаль, порожній;Але на цій штуці нічого немає;О ні! На цьому шматку #trash# нічого немає;(name-n), здається, порожній;Схоже, хтось уже тут побував і все з нього забрав, хоча;(name-n), як порожній (name-n), нічого на собі не має;

emptysupporter_multi:На (name-n) нічого немає;(name-n) порожній;Погляньте на (name-n). На цьому шматку #trash# нічого немає;Але на (name-n) нічого немає;Яке розчарування, тут нічого немає;

# Шаблони опису опорних поверхонь
#--------------------------------


# Розширювані елементи для символів опорних поверхонь
#---------------------------------------------------

on_it:на ньому;лежить на ньому;спочиває на ньому;на ньому
ContentsS-:Вміст-;На ньому представлені такі предмети-;На ньому ви можете побачити такі предмети-;На ньому лежать такі предмети-;На (name-n) представлені такі предмети-;На (name-n) ви можете побачити такі предмети-;На (name-n) лежать такі предмети-
held:утримувався;переносився;мав;був представлений;утримувався піднятим;використовувався як опора
trash:сміття;мотлох;непотріб

