# Описи виходів
#----------------

# room_desc_(d): описує одні двері в кімнаті
# room_desc_(dir): описує один незаблокований вихід у кімнаті
# room_exit_desc: описує кілька незаблокованих виходів у кімнаті
# room_desc_exits: можливо, не потрібен
# room_desc_doors_closed: описує групу закритих дверей у кімнаті
# room_desc_doors_open: описує групу відкритих дверей у кімнаті

room_desc_(d):Є #i7_closed/open# (name), що ведуть (dir).
room_desc_(dir):Є #unblocked# вихід на (dir).;Є вихід на (dir). Не хвилюйся, він #unblocked#.;Потрібен #unblocked# вихід? Спробуй піти (dir).;Не любиш двері? Чому б не піти (dir), цей прохід #unblocked#.
room_exit_desc:#easy1#.;#medium1#.;#hard1#.
room_desc_exits:Там [is an|are] #unblocked# [exit|exits] до (dir).
room_desc_doors_closed:#easy0a#.
room_desc_doors_open:#easy0b#.
#[if (name) is open]#room_desc_doors_open#[else if (name) is closed]#room_desc_doors_open#[end if]
#room_(d)_exit_desc_alt:[If (name) is open]#easy2#[else if (name) closed] closed [end if];[If (name) is open]#medium2#[else if (name) is closed] closed [end if];[If (name) is open]#hard2#[else if (name) is closed] closed [end if]
#room_(d)_exit_desc:[if (name) is open]#easy3#[else if (name) is closed] closed [end if];[If (name) is open]#medium3#[else if (name) is closed] closed [end if];[If (name) is open]#hard3#[else if (name) is closed]closed[end if]

# Шаблони опису виходів

# 0a #

