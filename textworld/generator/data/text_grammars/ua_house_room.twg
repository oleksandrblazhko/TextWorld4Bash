# Роздільники описів
#-------

# Використовуються для розділення описів різних типів об'єктів

#First
#first:Спочатку ти шукаєш (next object type);Спочатку ти оглядаєш кімнату в пошуках (next object type);Спочатку ти оглядаєш кімнату, шукаючи (next object type)
#Middle
#middle:Після цього ти шукаєш (next object type);З'ясувавши кількість (previous object type), ти починаєш шукати (next object type);
#Last
#last:і, нарешті, ти перевіряєш наявність (next object type)

# Описи контейнерів
#----------------------

# Правила опису контейнерів
# Доцільно розділити їх за рівнями складності
# room_desc_(c): генерує всі описи контейнерів
# containerdescription: містить усі описи зовнішнього вигляду контейнерів
# room_desc_(c)_1_name: описує контейнер як прикметник + іменник
# room_dec_(c)_1_noun: описує контейнер як іменник
# room_desc_(c)_content: визначає, чи додавати опис вмісту контейнера залежно від того, відкритий він чи закритий
# opencontainer: текст, який додається, якщо контейнер відкритий
# room_desc_(c)_2_adj: додає прикметник і список вмісту
# room_desc_(c)_2: список вмісту без прикметника

room_desc_(c):#containerdescription##room_desc_(c)_content#
#special_container#.
containerdescription:#room_desc_(c)_1_name#;#room_desc_(c)_1_noun#
room_desc_(c)_content:[if (obj) is open and there is something in the (obj)] #opencontainer##suffix#[end if][if (obj) is open and the (obj) contains nothing] #emptyreaction#[end if]
opencontainer:(name) містить #i7_list_in#
#room_desc_(c)_2_adj#;#room_desc_(c)_2#
emptyreaction:(name-n) порожній — який жахливий день!;(name-n) порожній! Яка марна трата дня!;(name-n) порожній! Це найгірше, що взагалі могло статися!;Порожньо! Що це за кошмарний TextWorld?;Яке розчарування! (name-n) порожній!
room_desc_(c)_1_name:#reg-a#;#normal-a#;#difficult-a#;#moredifficult-a#;#playful-a#

reg-a:#a1#;#a2#
normal-a:#a3#;#a4#;#a5#
difficult-a:#a6#
moredifficult-a:#reg-a#
playful-a:#reg-a#

room_desc_(c)_1_noun:#reg-b#;#normal-b#;#difficult-b#;#moredifficult-b#;#playful-b#

reg-b:#b1#;#b2#
normal-b:#b3#;#b4#;#b5#
difficult-b:#reg-b#
moredifficult-b:#reg-b#
playful-b:#reg-b#

