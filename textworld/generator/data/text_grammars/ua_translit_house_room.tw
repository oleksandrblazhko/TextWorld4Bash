# Opys opornykh poverkhon (Supporter)
#------------------------------------
# Podibno do opysiv konteineriv, ale bez vidkryttia/zakryttia abo zamykannia/vidmykannia
# room_desc_(s): holovnyi element
# room_desc_(s)_1_noun: opys opory bez prykmetnyka. Poiednuietsia z --> room_desc_(s)_2_adj
# room_desc_(s)_1_name: te same, shcho vyshche, ale z prykmetnykom
# room_desc_(s)_2_adj: prykmetnyk dlia opory plius spysok predmetiv na nii
# room_desc_(s)_2:

room_desc_(s):#room_desc_(s)_1_noun# #room_desc_(s)_2_adj#;#room_desc_(s)_1_name# #room_desc_(s)_2#

room_desc_(s)_1_noun:#prefix# (name-n)#suffix_(s)_mid#

room_desc_(s)_1_name:#prefix# (name)#suffix_(s)_mid#

room_desc_(s)_2_adj:(name-n) ye (name-adj).[if there is something on the (obj)] Na (name) #how_see_u# #i7_list_on##suffix_(s)_end#[end if][if there is nothing on the (obj)] #emptysupporter##suffix_(s)_end_angry#[end if]

#;(name-n) ye (name-adj) [if name has something on it] na (name) #i7_list_on#[else if the (name) is empty]#emptysupporter#[end if]

