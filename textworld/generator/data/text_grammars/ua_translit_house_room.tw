# Opysy vykhodiv
#--------------

# room_desc_(d): opysuie odni dveri v kimnati
# room_desc_(dir): opysuie odyn nezablokovanyi vykhid u kimnati
# room_exit_desc: opysuie kilka nezablokovanykh vykhodiv u kimnati
# room_desc_exits: mozhlyvo, nepotribne
# room_desc_doors_closed: opysuie hrupu zakrytykh dverei u kimnati
# room_desc_doors_open: opysuie hrupu vidkrytykh dverei u kimnati

room_desc_(d):Ye #i7_closed/open# (name), shcho vedut (dir).

room_desc_(dir):Ye #unblocked# vykhid do (dir).;Ye vykhid do (dir). Ne khvyliuitesia, vin #unblocked#.;Potriben #unblocked# vykhid? Sprobuite pity (dir).;Vy ne liubyte dveri? Todi chomu b ne pity (dir), tsei vkhid #unblocked#.

room_exit_desc:#easy1#.;#medium1#.;#hard1#.

room_desc_exits:Tam [ye|ye] #unblocked# [vykhid|vykhody] do (dir).

room_desc_doors_closed:#easy0a#.
room_desc_doors_open:#easy0b#.

#[if (name) is open]#room_desc_doors_open#[else if (name) is closed]#room_desc_doors_open#[end if]

#room_(d)_exit_desc_alt:[If (name) is open]#easy2#[else if (name) closed] zakrytyi [end if];[If (name) is open]#medium2#[else if (name) is closed] zakrytyi [end if];[If (name) is open]#hard2#[else if (name) is closed] zakrytyi [end if]

#room_(d)_exit_desc:[if (name) is open]#easy3#[else if (name) is closed] zakrytyi [end if];[If (name) is open]#medium3#[else if (name) is closed] zakrytyi [end if];[If (name) is open]#hard3#[else if (name) is closed]zakrytyi[end if]

# Shablony opysu vykhodiv
#----------------------

# 0a #

easy0a:Tut ye (^), (name-indefinite) zakrytykh dverei;Pohlianmo, skilky tut zakrytykh dverei. Skhozhe, (^), (name-indefinite);Tut ye (^), (name-indefinite) zakrytykh dverei;

# 0b #

easy0b:Tut ye (^), (name-indefinite) vidkrytykh dverei;Pohlianmo, skilky tut vidkrytykh dverei. Skhozhe, (^), (name-indefinite)

# 1 #

easy1:Tam [ye #unblocked# vykhid|ye #unblocked# vykhody] do (dir);Tam [ye #unblocked# vykhid|ye [vykhid|vykhody] do (dir). I ne khvyliuitesia, [vin ye|vony ye] #unblocked#

medium1:[Vykhid|Vykhody] #unblocked# [vede|vedut] do (dir);Zvidsy mozhna pity (dir), ne maiuchy spravy z zhodnymy dveryma

hard1:skhozhe, vy mozhete vyity do (dir), yakshcho dveri — ne zovsim vasha #yourthing#;yakshcho vy khochete pity, a dveri spravdi ne vasha #yourthing#, mozhete sprobuvaty pity (dir);Yakshcho vy ne duzhe liubyte dveri, mozhete vyity cherez (dir);Yakshcho vy ne fanat dverei, mozhete vyity cherez (dir);ne liubyte dveri? Todi chomu b ne pity (dir);Korysna porada — yakshcho pidete (dir), vam ne dovedetsia maty spravu z dveryma

# 2 #

easy2:#easy21#;#easy22#

easy21:Tam [ye dveri|ye dveri], #looks# (name-adj), shcho vedut (dir);(name) vede (dir)

easy22:Tam ye (name-indefinite), shcho vede (dir)

medium2:Vy #canshould# bachyty [dveri|dveri] [bilia|shcho blokuiut] (dir) [vykhid|vykhody]

hard2:Yak vam vyity? Nu, tam [ye dveri|ye dveri] u napriamku (dir) vid vas

