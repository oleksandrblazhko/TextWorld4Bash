# Ukrainian translation of house_instruction.twg.
# Inform 7/TextWorld control references are preserved.
#-------------------------
#Instructions Grammar
#-------------------------
obj_types:(o|k|f)
obj_types_no_key:(o|f)
on_types:(c|s)
lock_types:(c|d)
eat_types:(f)
close_open_types:(d|c)
lock_type_var:#lock_types#;#lock_types# #in_the_(r)#
(s)_var:(s);(s) #in_the_(r)#
(c)_var:(c);(c) #in_the_(r)#
on_var:#on_types#;#on_types# #in_the_(r)#
in_the_(r):у (r);всередині (r);в (r)
make_syn_u:Переконайся;Перевір;Зроби так, щоб;Переконайся в цьому;Перевір і переконайся;Переконайся неодмінно
make_syn_v:переконайся;перевір;зроби так, щоб;переконайся в цьому;перевір і переконайся;переконайся неодмінно
by_the_syn:за допомогою
init_syn:у ньому;всередині;розміщений усередині
into_syn:у;всередину

#actions
##actions should start with a verb (ie:ensure, make sure, etc (these could probably just be a tag))
look:озирнися в (r).
examine:оглянь (o|k|f|d|c|s|t).
inventory:перевір свій інвентар.
take:#take_synonym_1# #obj_types# у (r).;#take_synonym_1# #obj_types# з (r).;#take_synonym_1# #obj_types#, що знаходиться у (r).
take_synonym_1:візьми;отримай;забери;підбери
take/s:#take_synonym_1# #obj_types# з #on_var#.
take/c:#take_synonym_1# #obj_types# з #on_var#.
take:#pick-up_synonym_1# #obj_types# з підлоги (r).
pick-up_synonym_1:підбери;отримай;забери;підніми;візьми
pick-up_synonym_v:Підбери;Отримай;Забери;Підніми;Візьми
insert:#insert_syn_1# #obj_types# #into_syn# #(c)_var#.;ти можеш #insert_syn_1# #obj_types# #into_syn# #(c)_var#.
insert_syn_u:Встав;Поклади;Помісти;Розмісти
insert_syn_1:встав;поклади;помісти;розмісти
insert_syn_v:вставлений;покладений;поміщений;розміщений
begood:добре;чудово;фантастично;чудова ідея
put:#put_syn_v# #obj_types# на #(s)_var#.
put_syn_u:Поклади;Розмісти;Постав;Помісти
put_syn_v:поклади;розмісти;постав;помісти
on_it_syn:на ньому;на нього
drop:#drop_syn_v# #obj_types# на підлогу в (r).
drop_syn_u:Поклади
drop_syn_v:поклади;кинь;залиш;кинь;розмісти
eat:#eat_syn_1# #eat_var#.
eat_syn_u:З'їж
eat_syn_1:з'їж
eat_syn_v:з'їдений
open:відкрий #lock_type_var#.;переконайся, що #lock_type_var# відкритий.;#make_syn_v#, що #lock_type_var# #open_syn#.
open_syn:відкритий;відкрито;навстіж;прочинений
close:закрий #lock_type_var#.;#make_syn_v#, що #lock_type_var# #closed_syn#.
closed_syn:закритий;зачинений
eat_var:#eat_types#;#eat_types#
on_var:#on_types#;#on_types# #in_the_(r)#
unlock:#unlock_key#;#unlock_no_key#
unlock_key:відкрий #lock_type_var# #by_the_syn# (k).;перевір, що #lock_type_var# розблокований #by_the_syn# (k).;#make_syn_v#, що #lock_type_var# розблокований #by_the_syn# (k).;встав (k) у замок #lock_type_var#, щоб розблокувати його.
unlock_no_key:розблокуй #lock_type_var#.;#make_syn_v#, що #lock_type_var# розблокований.
lock:#lock_key#;#lock_no_key#
lock_key:замкни #lock_type_var# #by_the_syn# (k).;#make_syn_v#, що #lock_type_var# замкнений #by_the_syn# (k).;#insert_syn_u# (k) у #lock_type_var#, щоб замкнути його.
lock_no_key:замкни #lock_type_var#.;#make_syn_v# #lock_type_var# замкнений.;#make_syn_v#, що #lock_type_var# замкнений.
go/north:#go_syn_l# на північ.;#tryto# #go_syn_l# на північ.
go/south:#go_syn_l# на південь.;#tryto# #go_syn_l# на південь.
go/east:#go_syn_l# на схід.;#tryto# #go_syn_l# на схід.
go/west:#go_syn_l# на захід.;#tryto# #go_syn_l# на захід.
go/north/d:#go_syn_l# через північний (d).;#tryto# #go_syn_l# через північний (d).
go/south/d:#go_syn_l# через південний (d).;#tryto# #go_syn_l# через південний (d).
go/east/d:#go_syn_l# через східний (d).;#tryto# #go_syn_l# через східний (d).
go/west/d:#go_syn_l# через західний (d).;#tryto# #go_syn_l# через західний (d).
go_syn_u:Йди;Рушай;Вирушай;Подорожуй;Рухайся;Йди до;Здійсни подорож
go_syn_l:йди;рушай;вирушай;подорожуй;рухайся;йди до;здійсни подорож
go_syn_v:відвідав;подорожував;рухався;вирушив;пішов
tryto:спробуй;доклади зусиль, щоб;зроби спробу;спробуй виконати
wait:Зачекай.

#action expandables
#---------------
#Compound Command Description Functions
#----------------
ig_unlock_open:відкрий замкнений #lock_types# за допомогою (k).;розблокуй і відкрий #lock_types#.;розблокуй і відкрий #lock_types# за допомогою (k).;відкрий #lock_types# за допомогою (k).
ig_unlock_open_take:відкрий замкнений #lock_types# за допомогою (k) і візьми #obj_types_no_key#.;розблокуй #lock_types# і візьми #obj_types_no_key#.;розблокуй #lock_types# за допомогою (k) і візьми #obj_types_no_key#.;візьми #obj_types_no_key# із замкненого #lock_types#.
ig_open_take:візьми #obj_types# з (c).;відкрий (c) і візьми #obj_types#.;візьми #obj_types# із закритого (c).
ig_take/c_unlock:візьми (k) і використай його, щоб розблокувати #lock_types#.;розблокуй #lock_types# за допомогою (k).
ig_take/s_unlock:візьми (k) і використай його, щоб розблокувати #lock_types#.;розблокуй #lock_types# за допомогою (k).
ig_take_unlock:#pick-up_synonym_1# (k) і використай його, щоб розблокувати #lock_types#.;розблокуй #lock_types# за допомогою (k).
ig_open_insert:відкрий (c) і поклади #obj_types# у нього.;поклади #obj_types# у закритий (c).
ig_insert_close:поклади #obj_types# у (c) і закрий його.;закрий (c) після того, як покладеш у нього #obj_types#.
ig_close_lock:закрий #lock_types# і замкни його.;закрий #lock_types# і замкни його за допомогою (k).

#Flavour Text
#----------------
quest:#prologue# (list_of_actions) #epilogue#
quest_one_action:#prologue_one_action# (action)
prologue:#welcome#! Ось твоє завдання на сьогодні. #newsentence#;#welcome#! Ось як грати! #newsentence#;#welcome#! #newsentence#;Гей, дякую, що завітав до TextWorld! Є дещо, що я хочу, щоб ти зробив.
prologue_one_action:#welcome#! Твоє завдання на сьогодні —;#welcome#!;Твоя мета —;Гей, дякую, що завітав до TextWorld! Будь ласка,
newsentence:Перш за все,;Насамперед,;Перший крок —;Спочатку,;Твоя перша мета —;Перше, що я хочу, щоб ти зробив, —;Перш за все, якщо це не надто складно, я хочу, щоб ти;Насамперед ти можеш;Спочатку було б #begood#, якби ти
action_separator: Потім, ; Далі, ; Після цього, ; Якщо тобі вдасться #do# це, ; Коли ти #do# це, ; Зробивши це, ; Після цього, ; Коли з цим буде покінчено, ; Коли це буде виконано, ; Після завершення цього, ; Гаразд, а потім, ; А потім, ;#emptyinstruction1#;#emptyinstruction2#;#emptyinstruction3#;#emptyinstruction4#;#emptyinstruction5#;#emptyinstruction6#;#emptyinstruction7#;#emptyinstruction8#;#emptyinstruction9#;#emptyinstruction10#
epilogue:Коли з усім цим буде покінчено, можеш зупинитися!;І коли ти це зробиш, ти переможеш!;Якщо ти це зробиш, ти станеш переможцем!;Ось і все!;Зрозумів? Чудово!;Гаразд, дякую!
do:виконати;зробити;виконати успішно;дістатися до виконання;завершити;досягти успіху;впоратися
welcome:Ласкаво просимо до TextWorld;Ти зараз граєш у #exciting# #game# TextWorld;Ласкаво просимо до чергової #exciting# #game# TextWorld;Час досліджувати дивовижний світ TextWorld;Приготуйся підбирати предмети й класти їх у різні місця, адже ти щойно потрапив до TextWorld;Сподіваюся, ти готовий заходити до кімнат і взаємодіяти з предметами, адже ти щойно потрапив до TextWorld;Хто має віртуальну машину і зараз збирається зіграти в #exciting# раунд TextWorld? Ти!
exciting:захопливий;динамічний;дивовижний;цікавий
game:гра;раунд;сеанс;епізод

##Action separators
##Need at least 5 for each action type
action_separator_take: #afterhave# #havetaken# #obj_types#, ; #after# #taking# #obj_types#, ; З #obj_types#, ; Якщо ти зможеш дістати #obj_types#, ;#emptyinstruction1#;#emptyinstruction2#;#emptyinstruction3#;#emptyinstruction4#;#emptyinstruction5#;#emptyinstruction6#;#emptyinstruction7#;#emptyinstruction8#;#emptyinstruction9#;#emptyinstruction10#
action_separator_take/s: #afterhave# #havetaken# #obj_types#, ; #after# #taking# #obj_types#, ; З #obj_types#, ; Якщо ти зможеш дістати #obj_types#, ;#emptyinstruction1#;#emptyinstruction2#;#emptyinstruction3#;#emptyinstruction4#;#emptyinstruction5#;#emptyinstruction6#;#emptyinstruction7#;#emptyinstruction8#;#emptyinstruction9#;#emptyinstruction10#
action_separator_take/c: #afterhave# #havetaken# #obj_types#, ; #after# #taking# #obj_types#, ; З #obj_types#, ; Якщо ти зможеш дістати #obj_types#, ;#emptyinstruction1#;#emptyinstruction2#;#emptyinstruction3#;#emptyinstruction4#;#emptyinstruction5#;#emptyinstruction6#;#emptyinstruction7#;#emptyinstruction8#;#emptyinstruction9#;#emptyinstruction10#
action_separator_eat: #afterhave# #ate# #eat_types#, ;#emptyinstruction1#;#emptyinstruction2#;#emptyinstruction3#;#emptyinstruction4#;#emptyinstruction5#;#emptyinstruction6#;#emptyinstruction7#;#emptyinstruction8#;#emptyinstruction9#;#emptyinstruction10#
action_separator_insert: #afterhave# #inserted# #obj_types# у (c), ; #after# #inserting# #obj_types# у (c), ;#emptyinstruction1#;#emptyinstruction2#;#emptyinstruction3#;#emptyinstruction4#;#emptyinstruction5#;#emptyinstruction6#;#emptyinstruction7#;#emptyinstruction8#;#emptyinstruction9#;#emptyinstruction10#
action_separator_put: #afterhave# #put_v# #obj_types# на (s), ; #after# #putting# #obj_types# на (s), ;#emptyinstruction1#;#emptyinstruction2#;#emptyinstruction3#;#emptyinstruction4#;#emptyinstruction5#;#emptyinstruction6#;#emptyinstruction7#;#emptyinstruction8#;#emptyinstruction9#;#emptyinstruction10#
action_separator_open: #afterhave# #opened# #close_open_types#, ; #after# #opening# #close_open_types#, ;#emptyinstruction1#;#emptyinstruction2#;#emptyinstruction3#;#emptyinstruction4#;#emptyinstruction5#;#emptyinstruction6#;#emptyinstruction7#;#emptyinstruction8#;#emptyinstruction9#;#emptyinstruction10#
action_separator_unlock: #afterhave# #unlocked# #lock_types#, ; #after# #unlocking# #lock_types#, ;#emptyinstruction1#;#emptyinstruction2#;#emptyinstruction3#;#emptyinstruction4#;#emptyinstruction5#;#emptyinstruction6#;#emptyinstruction7#;#emptyinstruction8#;#emptyinstruction9#;#emptyinstruction10#
action_separator_lock: #afterhave# #locked# #lock_types#, ; #after# #locking# #lock_types#, ;#emptyinstruction1#;#emptyinstruction2#;#emptyinstruction3#;#emptyinstruction4#;#emptyinstruction5#;#emptyinstruction6#;#emptyinstruction7#;#emptyinstruction8#;#emptyinstruction9#;#emptyinstruction10#
action_seperator_go: #afterhave# #gone# (dir), ; #after# #getting# (dir), ; коли ти (dir), ; коли ти в (dir), ; Якщо тобі вдасться піти (dir), ;#emptyinstruction1#;#emptyinstruction2#;#emptyinstruction3#;#emptyinstruction4#;#emptyinstruction5#;#emptyinstruction6#;#emptyinstruction7#;#emptyinstruction8#;#emptyinstruction9#;#emptyinstruction10#
action_seperator_go/south: #afterhave# пішов на південь, ;#emptyinstruction1#;#emptyinstruction2#;#emptyinstruction3#;#emptyinstruction4#;#emptyinstruction5#;#emptyinstruction6#;#emptyinstruction7#;#emptyinstruction8#;#emptyinstruction9#;#emptyinstruction10#
action_seperator_go/north: #afterhave# пішов на північ, ;#emptyinstruction1#;#emptyinstruction2#;#emptyinstruction3#;#emptyinstruction4#;#emptyinstruction5#;#emptyinstruction6#;#emptyinstruction7#;#emptyinstruction8#;#emptyinstruction9#;#emptyinstruction10#
action_seperator_go/east: #afterhave# пішов на схід, ;#emptyinstruction1#;#emptyinstruction2#;#emptyinstruction3#;#emptyinstruction4#;#emptyinstruction5#;#emptyinstruction6#;#emptyinstruction7#;#emptyinstruction8#;#emptyinstruction9#;#emptyinstruction10#
action_seperator_go/west: #afterhave# пішов на захід, ;#emptyinstruction1#;#emptyinstruction2#;#emptyinstruction3#;#emptyinstruction4#;#emptyinstruction5#;#emptyinstruction6#;#emptyinstruction7#;#emptyinstruction8#;#emptyinstruction9#;#emptyinstruction10#
action_separator_close: #afterhave# #closed# #close_open_types#, ; #after# #closing# #close_open_types#, ;#emptyinstruction1#;#emptyinstruction2#;#emptyinstruction3#;#emptyinstruction4#;#emptyinstruction5#;#emptyinstruction6#;#emptyinstruction7#;#emptyinstruction8#;#emptyinstruction9#;#emptyinstruction10#
action_separator_drop: #afterhave# #dropped# #obj_types#, ; #after# #dropping# #obj_types#, ;#emptyinstruction1#;#emptyinstruction2#;#emptyinstruction3#;#emptyinstruction4#;#emptyinstruction5#;#emptyinstruction6#;#emptyinstruction7#;#emptyinstruction8#;#emptyinstruction9#;#emptyinstruction10#

#Separator Symbols
afterhave:Після того, як ти;Виконавши;Коли ти;Якщо ти
havetaken:взяв;отримав;підібрав
havepicked-up:взяв;отримав;підібрав
after:Після
taking:береш;отримуєш;підбираєш;забираєш
picking-up:береш;отримуєш;підбираєш;забираєш
ate:з'їв;спожив
inserted:вставив;поклав
inserting:вставляєш;кладеш
put_v:поклав;розмістив;поставив;поклав
putting:кладеш;розміщуєш;ставиш;встановлюєш
opening:відкриваєш;відчиняєш
opened:відкрив;відчинив
unlocked:розблокував
unlocking:розблоковуєш
locked:замкнув
locking:замикаєш
gone:пішов;перейшов
getting:йдеш;переміщаєшся
closed:закритий;зачинений
closing:закриваєш;зачиняєш
dropped:поклав;кинув;залишив;відкинув
dropping:кладеш;залишаєш
emptyinstruction1: А потім, ;
emptyinstruction2: Потім, ;
emptyinstruction3: Після цього, ;
emptyinstruction4: А потім, ;
emptyinstruction5: Після цього, ;
emptyinstruction6: Потім, ;
emptyinstruction7: А потім, ;
emptyinstruction8: Після цього, ;
emptyinstruction9: А потім, ;
emptyinstruction10: Потім, ;
