rest_(c):#rest_(c)_adj# | #rest_(c)_noun#
rest_(c)_noun:комод;скриня;кошик;коробка;сейф;шафка;скриня;скринька;валіза;портплед
rest_(c)_adj:новий;запилений;чистий;дивовижний

work_(c):#work_(c)_adj# | #work_(c)_noun#
work_(c)_noun:шафа;коробка;сейф;шафка;скриня;бюро;скринька;футляр;валіза;ящик для інструментів;портплед;вітрина
