# Їжа
# Кожен roomType може мати специфічну їжу
#-------------------
# Наведене нижче може працювати як розширювана харчова піраміда.
# Її можна зробити специфічною для кімнати.

# Базова їжа
(f):#(f)_adj# | #(f)_noun#
(f)_adj:#(f)_adj_good#;#(f)_adj_bad#;#(f)_adj_neutral#
(f)_noun:#(f)_noun_fruit#;#(f)_noun_vegetable#;#(f)_noun_grain#;#(f)_noun_protein#;#(f)_noun_dairy#;#candy#

